# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# React development server
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# Local development values only. Production must use a dedicated least-privilege
# database account and non-empty password.
DB_NAME=student_finance
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Account authentication
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
GOOGLE_CLIENT_ID=
UPI_CALLBACK_SECRET=
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Firebase Cloud Messaging (FCM HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Email (console backend is used automatically when DJANGO_DEBUG=True)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Student Finance <no-reply@example.com>

# Optional deployment settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# For production behind a trusted TLS proxy, set HTTPS_REDIRECT_AT_PROXY=True.
# Do not enable HSTS subdomains/preload unless every affected host is HTTPS-only.
LOG_LEVEL=INFO
